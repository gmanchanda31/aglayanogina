# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — track examples, ignore real values
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scrape artifacts — kept only as a local reference, not part of the build.
# All content data has been moved to /data/ (parsed.json + image_plan.json).
/_scrape/

# dev screenshots (manual + playwright) — anything top-level + the playwright cache
/audit-*.png
/fix-*.png
/og-*.png
/phase*-*.png
/step*.png
/homepage-*.png
/.playwright-mcp/
